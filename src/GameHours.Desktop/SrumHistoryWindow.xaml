<Window x:Class="GameHours.Desktop.SrumHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar historial de Windows · GameHours"
        Width="860"
        Height="620"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Recuperar historial de Windows"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="GameHours analiza SRUM localmente para recuperar historial anterior al seguimiento y detectar actividad estimada en huecos posteriores. Nunca convierte estos datos en sesiones exactas ni los suma cuando pueden solapar una sesión medida." />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceAltBrush}"
                CornerRadius="12"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SourceText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="AnalyzeButton"
                        Content="Analizar de nuevo"
                        Background="#292F3D"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Click="Analyze_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="JUEGO" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Grid.Column="2" Text="ESTIMADO" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="COBERTURA" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="ESTADO" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Candidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#262D3A"
                                        BorderThickness="0,1,0,0"
                                        Padding="4,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Checked="CandidateSelectionChanged"
                                                  Unchecked="CandidateSelectionChanged" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameTitle}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ApplicationText}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="10"
                                                       Margin="0,3,12,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PlaytimeText}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CoverageText}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding StateText}"
                                                   Foreground="{StaticResource AccentLightBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="SRUM sólo aporta evidencia estimada. GameHours guarda únicamente el resumen normalizado por juego y no conserva las filas de otras aplicaciones."
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,18,0" />
            <Button Grid.Column="1"
                    Content="Cerrar"
                    Background="#292F3D"
                    Margin="0,0,8,0"
                    Click="Close_Click" />
            <Button Grid.Column="2"
                    x:Name="ImportButton"
                    Content="Importar seleccionados"
                    IsEnabled="False"
                    Click="ImportSelected_Click" />
        </Grid>
    </Grid>
</Window>
