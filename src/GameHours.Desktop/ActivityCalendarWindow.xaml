<Window x:Class="GameHours.Desktop.ActivityCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendario de actividad · GameHours"
        Width="980"
        Height="690"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Calendario de actividad"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="Tu diario de sesiones medidas, logros desbloqueados e hitos al 100 %."
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="PreviousButton"
                        Content="←"
                        Background="{StaticResource SurfaceAltBrush}"
                        Padding="12,8"
                        Margin="0,0,6,0"
                        Click="Previous_Click" />
                <Button x:Name="TodayButton"
                        Content="Hoy"
                        Background="{StaticResource SurfaceAltBrush}"
                        Padding="12,8"
                        Margin="0,0,6,0"
                        Click="Today_Click" />
                <Button x:Name="NextButton"
                        Content="→"
                        Background="{StaticResource SurfaceAltBrush}"
                        Padding="12,8"
                        Margin="0,0,6,0"
                        Click="Next_Click" />
                <Button x:Name="RefreshButton"
                        Content="Actualizar"
                        Background="{StaticResource SurfaceAltBrush}"
                        Padding="12,8"
                        Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding MonthText}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="Tiempo medido"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding MonthSummaryText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,0,12" />

                    <UniformGrid Grid.Row="2" Columns="7" Margin="2,0,2,6">
                        <TextBlock Text="L" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                        <TextBlock Text="M" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                        <TextBlock Text="X" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                        <TextBlock Text="J" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                        <TextBlock Text="V" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                        <TextBlock Text="S" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                        <TextBlock Text="D" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                    </UniformGrid>

                    <ItemsControl Grid.Row="3" ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2" MinHeight="58">
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            CornerRadius="9" />
                                    <Border Background="{StaticResource AccentBrush}"
                                            CornerRadius="9"
                                            Opacity="{Binding ActivityOpacity}"
                                            IsHitTestVisible="False" />
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            Padding="7"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            ToolTip="{Binding ToolTipText}"
                                            Click="Day_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding DayNumberText}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PlaytimeText}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           VerticalAlignment="Bottom" />
                                                <StackPanel Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding AchievementText}"
                                                               FontSize="9"
                                                               Foreground="{StaticResource AccentLightBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding CompletionText}"
                                                               FontSize="8"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentLightBrush}"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                    <Border BorderBrush="{StaticResource AccentLightBrush}"
                                            BorderThickness="{Binding SelectionThickness}"
                                            CornerRadius="9"
                                            IsHitTestVisible="False" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding SelectedDateText}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding SelectedDaySummaryText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,14"
                               TextWrapping="Wrap" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedDayEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#262D3A"
                                            BorderThickness="0,1,0,0"
                                            Padding="2,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding WhenText}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,10,0" />
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding GameTitle}"
                                                               Foreground="{StaticResource AccentLightBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding KindText}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="9" />
                                                </Grid>
                                                <TextBlock Text="{Binding TitleText}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,5,0,0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DetailText}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="La intensidad representa tiempo medido. SRUM no se reparte entre días porque su ventana histórica no permite hacerlo con precisión."
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0" />
            <Button Grid.Column="1"
                    Content="Cerrar"
                    Background="{StaticResource SurfaceAltBrush}"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
