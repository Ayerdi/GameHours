<UserControl x:Class="GameHours.Desktop.RuntimeSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Background="{StaticResource SurfaceAltBrush}"
            BorderBrush="#342C63"
            BorderThickness="1"
            CornerRadius="12"
            Padding="18">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Actividad, privacidad y rendimiento"
                               FontWeight="SemiBold"
                               FontSize="15" />
                    <TextBlock Text="Controla cómo GameHours estima el tiempo activo y qué trabajo puede posponer mientras juegas."
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,24,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#171D27"
                        CornerRadius="10"
                        Padding="10,6"
                        VerticalAlignment="Top">
                    <TextBlock Text="LOCAL"
                               Foreground="{StaticResource AccentLightBrush}"
                               FontSize="9"
                               FontWeight="Bold" />
                </Border>
            </Grid>

            <Border Background="#151A23"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,16,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,22,0">
                        <TextBlock Text="Detección de ausencia (AFK)"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="AfkExplanationText"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="AfkComboBox"
                              Grid.Column="1"
                              MinHeight="34"
                              VerticalAlignment="Center"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="AfkComboBox_SelectionChanged" />
                </Grid>
            </Border>

            <Border x:Name="DeferredAfkBanner"
                    Visibility="Collapsed"
                    Background="#211D35"
                    BorderBrush="#6F5BD3"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Cambio AFK pendiente"
                               Foreground="{StaticResource AccentLightBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DeferredAfkText"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="#151A23"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,22,0">
                        <TextBlock Text="Impacto mínimo al jugar · Recomendado"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Mientras hay un juego abierto, aplaza tareas que pueden esperar, como refrescar vistas o buscar actualizaciones. No reduce la precisión del tiempo, el foco, los logros ni el guardado de la sesión."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox x:Name="LowImpactCheckBox"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Checked="LowImpactCheckBox_Changed"
                              Unchecked="LowImpactCheckBox_Changed" />
                </Grid>
            </Border>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatusText"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Gestionar ejecutables"
                            Background="#292F3D"
                            Margin="0,0,8,0"
                            Click="ManageExecutables_Click" />
                    <Button Content="Ver diagnóstico"
                            Background="#292F3D"
                            Click="Diagnostics_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
