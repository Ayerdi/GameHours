<Window x:Class="GameHours.Desktop.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novedades de GameHours"
        Width="680"
        Height="560"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Novedades de GameHours"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding VersionText}"
                       Foreground="{StaticResource AccentLightBrush}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="14"
                Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding NotesText}"
                           TextWrapping="Wrap"
                           LineHeight="22" />
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2"
                Content="Cerrar"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                MinWidth="100"
                Click="Close_Click" />
    </Grid>
</Window>
