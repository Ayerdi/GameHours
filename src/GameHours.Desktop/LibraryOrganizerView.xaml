<UserControl x:Class="GameHours.Desktop.LibraryOrganizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Organizar biblioteca"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="Elige tu estado, marca favoritos y oculta juegos sin tocar su historial."
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="← Volver"
                    Background="{StaticResource SurfaceAltBrush}"
                    Click="Back_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="BUSCAR"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="2,0,0,5" />
                <TextBox x:Name="SearchBox"
                         MinHeight="34"
                         Padding="10,7"
                         Background="{StaticResource WindowBackgroundBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="#342C63"
                         BorderThickness="1"
                         ToolTip="Filtra esta vista por título"
                         TextChanged="SearchBox_TextChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,5">
                <TextBlock x:Name="CountTextBlock"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Right" />
                <TextBlock Text="Los cambios se guardan al instante"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10"
                           Margin="0,2,0,0"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="105" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="JUEGO"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="1"
                       Text="ESTADO"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="2"
                       Text="FAVORITO"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="3"
                       Text="RESUMEN"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10"
                       FontWeight="Bold"
                       HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4"
                       Text="VISIBILIDAD"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10"
                       FontWeight="Bold"
                       HorizontalAlignment="Right" />
        </Grid>

        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="OrganizerItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,10"
                                Margin="0,0,0,3"
                                CornerRadius="10"
                                BorderBrush="#262D3A"
                                BorderThickness="0,1,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="105" />
                                </Grid.ColumnDefinitions>

                                <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="9"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            HorizontalAlignment="Left">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}"
                                                       Foreground="{StaticResource AccentLightBrush}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding Icon}"
                                                   Width="28"
                                                   Height="28"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LastActivityText, StringFormat=Última actividad · {0}}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource GameHoursComboBoxStyle}"
                                          Width="145"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding StatusOptions}"
                                          SelectedValue="{Binding CompletionStatus, Mode=OneWay}"
                                          SelectedValuePath="Status"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="StatusComboBox_SelectionChanged" />

                                <Button Grid.Column="2"
                                        Content="{Binding FavoriteGlyph}"
                                        ToolTip="{Binding FavoriteActionText}"
                                        Width="38"
                                        Height="34"
                                        Padding="0"
                                        FontSize="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        Click="Favorite_Click" />

                                <StackPanel Grid.Column="3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalText}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding AchievementText, StringFormat=Logros · {0}}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               Margin="0,3,0,0"
                                               HorizontalAlignment="Right" />
                                </StackPanel>

                                <Button Grid.Column="4"
                                        Content="{Binding VisibilityActionText}"
                                        Width="92"
                                        Padding="10,7"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        Click="Visibility_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
