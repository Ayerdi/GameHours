<Window x:Class="GameHours.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameHours"
        Width="980" Height="660"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="GameHours" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Tu tiempo de juego, sin depender del launcher."
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceAltBrush}"
                    CornerRadius="16"
                    Padding="13,7"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8"
                             Fill="{StaticResource SuccessBrush}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="#342C63"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="AHORA"
                                   Foreground="{StaticResource AccentLightBrush}"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding ActiveGameText}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,8,18,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ActiveGameSubtitle}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4,18,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                MinWidth="82"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="SESIÓN"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ActiveGameElapsedText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14"
                    Padding="20"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="JUEGOS"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding GameCountText}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0" />
                    <TextBlock Text="con historial local"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="TIEMPO TOTAL"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalPlaytimeText}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0" />
                    <TextBlock Text="medido + histórico"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="14"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Biblioteca local"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Tiempo medido por GameHours y evidencia histórica importada."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Actualizar"
                            Background="{StaticResource SurfaceAltBrush}"
                            Click="Refresh_Click" />
                </Grid>

                <Grid Grid.Row="1" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="JUEGO"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                    <TextBlock Grid.Column="1"
                               Text="TOTAL"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2"
                               Text="MEDIDO"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3"
                               Text="HISTÓRICO"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Right" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#262D3A"
                                        BorderThickness="0,1,0,0"
                                        Padding="4,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TotalText}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding MeasuredText}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding EstimatedText}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <CheckBox x:Name="StartupCheckBox"
                          Content="Iniciar GameHours con Windows"
                          Foreground="{StaticResource TextBrush}"
                          VerticalAlignment="Center"
                          Checked="StartupCheckBox_Changed"
                          Unchecked="StartupCheckBox_Changed" />
                <TextBlock Text="Cerrar la ventana lo deja funcionando en segundo plano."
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Salir de GameHours"
                    Foreground="#FF9AAF"
                    Background="#351923"
                    Padding="15,9"
                    Click="Exit_Click" />
        </Grid>
    </Grid>
</Window>
