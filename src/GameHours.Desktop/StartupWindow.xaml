<Window x:Class="GameHours.Desktop.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameHours"
        Width="470"
        Height="230"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Margin="1"
            Padding="28"
            Background="{StaticResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="GameHours"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="Tu tiempo de juego, sin depender del launcher."
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,5,0,0" />
            </StackPanel>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="1"
                       Text="Preparando biblioteca y detección…"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,28,0,10" />

            <ProgressBar Grid.Row="2"
                         Height="5"
                         IsIndeterminate="True"
                         VerticalAlignment="Top" />

            <TextBlock Grid.Row="3"
                       Text="GameHours está cargando los datos locales y revisando los launchers en segundo plano."
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,18,0,0" />
        </Grid>
    </Border>
</Window>
