<UserControl x:Class="GameHours.Desktop.GameDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource SurfaceBrush}"
            CornerRadius="14"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Content="← Volver a Biblioteca"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Foreground="{StaticResource MutedTextBrush}"
                    Padding="0,4"
                    Margin="0,0,0,16"
                    Click="Back_Click" />

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="64"
                        Height="64"
                        CornerRadius="14"
                        Background="{StaticResource SurfaceAltBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <Grid>
                        <TextBlock Text="{Binding Initial}"
                                   Foreground="{StaticResource AccentLightBrush}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Image Source="{Binding Icon}"
                               Width="52"
                               Height="52"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LastActivityText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,5,0,0" />
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="12"
                        Padding="14,10"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="TIEMPO TOTAL"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TotalText}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="MEDIDO"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding MeasuredText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="HISTÓRICO"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding EstimatedText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="EJECUTABLE ASOCIADO"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding ExecutableText}"
                                   Foreground="{StaticResource AccentLightBrush}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Background="#10141C"
                    CornerRadius="12"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Sesiones recientes"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Últimas sesiones medidas de este juego."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CUÁNDO"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Grid.Column="1"
                                   Text="DURACIÓN"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2"
                                   Text="CIERRE"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#262D3A"
                                            BorderThickness="0,1,0,0"
                                            Padding="4,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding WhenText}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DurationText}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ReasonText}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
