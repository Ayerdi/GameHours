<UserControl x:Class="GameHours.Desktop.ActivityCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch">
        <Grid MinHeight="390">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="300" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Calendario de actividad" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Sesiones medidas, logros e hitos al 100 % organizados por día."
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PreviousButton"
                            Content="←"
                            Background="{StaticResource SurfaceAltBrush}"
                            Padding="11,7"
                            Margin="0,0,6,0"
                            Click="Previous_Click" />
                    <Button x:Name="TodayButton"
                            Content="Hoy"
                            Background="{StaticResource SurfaceAltBrush}"
                            Padding="11,7"
                            Margin="0,0,6,0"
                            Click="Today_Click" />
                    <Button x:Name="NextButton"
                            Content="→"
                            Background="{StaticResource SurfaceAltBrush}"
                            Padding="11,7"
                            Margin="0,0,6,0"
                            Click="Next_Click" />
                    <Button x:Name="RefreshButton"
                            Content="Actualizar"
                            Background="{StaticResource SurfaceAltBrush}"
                            Padding="11,7"
                            Click="Refresh_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" MinHeight="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="430" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="14"
                        Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="216" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding MonthText}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="Tiempo medido"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding MonthSummaryText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <UniformGrid Grid.Row="2" Columns="7" Margin="2,0,2,4">
                            <TextBlock Text="L" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                            <TextBlock Text="M" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                            <TextBlock Text="X" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                            <TextBlock Text="J" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                            <TextBlock Text="V" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                            <TextBlock Text="S" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                            <TextBlock Text="D" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="10" />
                        </UniformGrid>

                        <ItemsControl Grid.Row="3" ItemsSource="{Binding Days}" MinHeight="216">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" Rows="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2" MinHeight="34">
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" />
                                        <Border Background="{StaticResource AccentBrush}"
                                                CornerRadius="8"
                                                Opacity="{Binding ActivityOpacity}"
                                                IsHitTestVisible="False" />
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="6"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                ToolTip="{Binding ToolTipText}"
                                                Click="Day_Click">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding DayNumberText}" FontWeight="SemiBold" FontSize="11" />
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding PlaytimeText}"
                                                               FontSize="8"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               VerticalAlignment="Bottom" />
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding AchievementText}"
                                                                   FontSize="8"
                                                                   Foreground="{StaticResource AccentLightBrush}"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding CompletionText}"
                                                                   FontSize="7"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentLightBrush}"
                                                                   HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Button>
                                        <Border BorderBrush="{StaticResource AccentLightBrush}"
                                                BorderThickness="{Binding SelectionThickness}"
                                                CornerRadius="8"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="14"
                        Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding SelectedDateText}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding SelectedDaySummaryText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedDayEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#262D3A" BorderThickness="0,1,0,0" Padding="2,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding WhenText}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="9"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,8,0" />
                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding GameTitle}"
                                                                   Foreground="{StaticResource AccentLightBrush}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding KindText}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="8" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding TitleText}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding DetailText}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="9"
                                                               Margin="0,2,0,0"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2"
                       Text="La intensidad representa tiempo medido. SRUM no se reparte entre días porque su ventana histórica no permite hacerlo con precisión."
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="9"
                       TextWrapping="Wrap"
                       Margin="2,10,2,0" />
        </Grid>
    </ScrollViewer>
</UserControl>
