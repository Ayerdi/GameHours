<UserControl x:Class="GameHours.Desktop.ActivityCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Calendario de actividad" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Sesiones medidas, logros e hitos al 100 % organizados por día."
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10"
                           Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PreviousButton"
                        Content="←"
                        Background="{StaticResource SurfaceAltBrush}"
                        Padding="9,5"
                        Margin="0,0,5,0"
                        Click="Previous_Click" />
                <Button x:Name="TodayButton"
                        Content="Hoy"
                        Background="{StaticResource SurfaceAltBrush}"
                        Padding="9,5"
                        Margin="0,0,5,0"
                        Click="Today_Click" />
                <Button x:Name="NextButton"
                        Content="→"
                        Background="{StaticResource SurfaceAltBrush}"
                        Padding="9,5"
                        Margin="0,0,5,0"
                        Click="Next_Click" />
                <Button x:Name="RefreshButton"
                        Content="Actualizar"
                        Background="{StaticResource SurfaceAltBrush}"
                        Padding="9,5"
                        Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" MinHeight="245">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="430" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="174" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding MonthText}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="Tiempo medido"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="9"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding MonthSummaryText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="9"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4" />

                    <UniformGrid Grid.Row="2" Columns="7" Margin="1,0,1,2">
                        <TextBlock Text="L" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="9" />
                        <TextBlock Text="M" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="9" />
                        <TextBlock Text="X" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="9" />
                        <TextBlock Text="J" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="9" />
                        <TextBlock Text="V" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="9" />
                        <TextBlock Text="S" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="9" />
                        <TextBlock Text="D" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" FontSize="9" />
                    </UniformGrid>

                    <ItemsControl Grid.Row="3" ItemsSource="{Binding Days}" MinHeight="174">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="1" MinHeight="28">
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="7" />
                                    <Border Background="{StaticResource AccentBrush}"
                                            CornerRadius="7"
                                            Opacity="{Binding ActivityOpacity}"
                                            IsHitTestVisible="False" />
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,3"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            ToolTip="{Binding ToolTipText}"
                                            Click="Day_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding DayNumberText}" FontWeight="SemiBold" FontSize="10" />
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PlaytimeText}"
                                                           FontSize="7"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           VerticalAlignment="Bottom" />
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding AchievementText}"
                                                               FontSize="7"
                                                               Foreground="{StaticResource AccentLightBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding CompletionText}"
                                                               FontSize="7"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentLightBrush}"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                    <Border BorderBrush="{StaticResource AccentLightBrush}"
                                            BorderThickness="{Binding SelectionThickness}"
                                            CornerRadius="7"
                                            IsHitTestVisible="False" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding SelectedDateText}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding SelectedDaySummaryText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="9"
                               Margin="0,3,0,6"
                               TextWrapping="Wrap" />
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SelectedDayGames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#262D3A"
                                            BorderThickness="0,1,0,0"
                                            Padding="2,5">
                                        <Expander Foreground="{StaticResource TextBrush}"
                                                  Background="Transparent"
                                                  HorizontalContentAlignment="Stretch"
                                                  IsExpanded="False">
                                            <Expander.Header>
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding GameTitle}"
                                                                   Foreground="{StaticResource AccentLightBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SummaryText}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="8"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DurationText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </Expander.Header>

                                            <ItemsControl ItemsSource="{Binding Events}"
                                                          Margin="14,4,0,2">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#262D3A"
                                                                BorderThickness="0,1,0,0"
                                                                Padding="2,6">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Cursor" Value="Arrow" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasSessionDetail}" Value="True">
                                                                            <Setter Property="Cursor" Value="Hand" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="68" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding WhenText}"
                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                           FontSize="8"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,1,7,0" />
                                                                <StackPanel Grid.Column="1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding TitleText}"
                                                                                   FontWeight="SemiBold"
                                                                                   FontSize="9"
                                                                                   TextWrapping="Wrap"
                                                                                   Margin="0,0,6,0" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding KindText}"
                                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                                   FontSize="8" />
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding DetailText}"
                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                               FontSize="8"
                                                                               Margin="0,2,0,0"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
