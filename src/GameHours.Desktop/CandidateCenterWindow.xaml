<Window x:Class="GameHours.Desktop.CandidateCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameHours · Juegos por identificar"
        Width="1040" Height="700"
        MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Juegos por identificar" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="GameHours no contará estas aplicaciones hasta que haya una identificación fiable o tú la confirmes."
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Añadir EXE…"
                        Background="{StaticResource SurfaceAltBrush}"
                        Margin="0,0,8,0"
                        Click="AddExecutable_Click" />
                <Button Content="Actualizar"
                        Background="{StaticResource SurfaceAltBrush}"
                        Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="PENDIENTES"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="6,4,6,10" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Candidates}"
                             SelectedItem="{Binding SelectedCandidate}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                                        Margin="0,0,0,6"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ExecutableName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ConfidenceText}"
                                                       Foreground="{StaticResource AccentLightBrush}"
                                                       Margin="10,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding SuggestedTitle}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LastSeenText}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14"
                    Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel IsEnabled="{Binding HasSelection}">
                        <TextBlock Text="{Binding SelectedCandidate.ExecutableName, TargetNullValue=Selecciona un candidato}"
                                   FontSize="21"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedCandidate.ExecutablePath}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="CONFIANZA" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SelectedCandidate.ConfidenceText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="MÉTODO" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SelectedCandidate.MethodText}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="VISTO" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SelectedCandidate.ObservationText}" FontSize="13" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Por qué ha llamado la atención"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Margin="0,20,0,8" />
                        <ItemsControl ItemsSource="{Binding SelectedCandidate.EvidenceLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,5" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,18" />

                        <TextBlock Text="Confirmar como juego nuevo" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="El nombre puede corregirse antes de guardarlo. El EXE quedará aprendido con confianza total."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SelectedCandidate.ProposedTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,7"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="Crear juego"
                                    Background="{StaticResource AccentBrush}"
                                    Click="CreateGame_Click" />
                        </Grid>

                        <TextBlock Text="Asociar a un juego existente" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0" />
                        <TextBlock Text="Útil para ejecutables secundarios, launchers o anti-cheat de un juego que GameHours ya conoce."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4,0,8" />
                        <ComboBox ItemsSource="{Binding ExistingGames}"
                                  SelectedItem="{Binding SelectedExistingGame}"
                                  DisplayMemberPath="Title"
                                  Padding="8,5" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Asociar como proceso del juego"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    Margin="0,0,8,0"
                                    Click="AssociateGame_Click" />
                        </StackPanel>

                        <TextBlock Text="Clasificar como proceso auxiliar" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0" />
                        <TextBlock Text="La clasificación se guarda localmente. Si eliges un juego arriba, también se aprende como helper de ese juego."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding HelperRoleChoices}"
                                      SelectedItem="{Binding SelectedHelperRole}"
                                      DisplayMemberPath="DisplayName"
                                      Padding="8,5"
                                      Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="Guardar clasificación"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    Click="SaveHelperRole_Click" />
                        </Grid>

                        <Button Content="Ignorar este ejecutable"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                Background="{StaticResource SurfaceAltBrush}"
                                Click="Ignore_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Cerrar" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
