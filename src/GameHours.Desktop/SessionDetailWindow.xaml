<Window x:Class="GameHours.Desktop.SessionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de sesión · GameHours"
        Width="760" Height="640" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock x:Name="GameTitleText" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="DateText" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18" />

            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="EJECUCIÓN" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="DurationText" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="EN PRIMER PLANO" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="FocusedText" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="ACTIVO ESTIMADO" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="ActiveText" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="AFK DETECTADO" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="AfkText" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
            </UniformGrid>

            <Border Background="#10141C" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0"><TextBlock Text="INICIO" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="StartText" Margin="0,5,0,12"/><TextBlock Text="FIN" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="EndText" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="FUERA DE PRIMER PLANO / NO OBSERVADO" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="UnfocusedText" Margin="0,5,0,12"/><TextBlock Text="UMBRAL AFK DE ESTA SESIÓN" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="AfkThresholdText" Margin="0,5,0,0"/></StackPanel>
                </Grid>
            </Border>

            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,14"><StackPanel><TextBlock Text="Calidad y procedencia" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="CaptureText" Margin="0,8,0,0"/><TextBlock x:Name="EndReasonText" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="TelemetryText" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Background="#151A23" CornerRadius="10" Padding="14"><TextBlock Text="AFK detectado = tiempo en primer plano que no se consideró activo según el umbral guardado para esta sesión. Los intervalos sin muestra fiable no se inventan ni se reparten entre foco/AFK." Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap"/></Border>
            <TextBlock x:Name="SessionIdText" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="2,14,2,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
