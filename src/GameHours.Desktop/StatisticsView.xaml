<UserControl x:Class="GameHours.Desktop.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Estadísticas" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Actividad mensual, atención y calidad del historial local."
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Content="Actualizar"
                    Background="{StaticResource SurfaceAltBrush}"
                    VerticalAlignment="Center"
                    Click="Refresh_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousButton"
                                    Content="←"
                                    Width="40"
                                    Height="32"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    Click="Previous_Click" />
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding MonthText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="La vista mensual usa sólo tiempo medido por GameHours."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="9"
                                           Margin="0,2,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="TodayButton"
                                        Content="Este mes"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        Margin="0,0,8,0"
                                        Click="Today_Click" />
                                <Button x:Name="NextButton"
                                        Content="→"
                                        Width="40"
                                        Height="32"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        Click="Next_Click" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="5" Margin="0,0,0,14">
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,7,0">
                                <StackPanel><TextBlock Text="TIEMPO" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding MonthPlaytimeText}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,7,0">
                                <StackPanel><TextBlock Text="DÍAS JUGANDO" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding MonthActiveDaysText}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,7,0">
                                <StackPanel><TextBlock Text="JUEGOS" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding MonthGameCountText}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,7,0">
                                <StackPanel><TextBlock Text="LOGROS" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding MonthAchievementCountText}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12">
                                <StackPanel><TextBlock Text="MEDIA / DÍA" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding MonthAverageText}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="#151A23" CornerRadius="10" Padding="14" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="MÁS JUGADO" Foreground="{StaticResource AccentLightBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding MonthMostPlayedTitleText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding MonthMostPlayedValueText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#151A23" CornerRadius="10" Padding="14" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="DÍA MÁS INTENSO" Foreground="{StaticResource AccentLightBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding MonthBusiestDayTitleText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding MonthBusiestDayValueText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Atención y calidad del dato" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Estas métricas sólo usan sesiones que realmente tienen telemetría. No se extrapola actividad a sesiones antiguas ni se reparte artificialmente entre meses."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           Margin="0,3,20,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#171D27" CornerRadius="9" Padding="9,5" VerticalAlignment="Top">
                                <TextBlock Text="TRANSPARENTE"
                                           Foreground="{StaticResource AccentLightBrush}"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <UniformGrid Columns="4">
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="EN PRIMER PLANO" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding LifetimeFocusedText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding LifetimeFocusRatioText}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVO ESTIMADO" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding LifetimeActiveText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding LifetimeActiveRatioText}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="COBERTURA TELEMETRÍA" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding TelemetryCoverageText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding TelemetryCoverageDetailText}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="DATOS MEDIDOS" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding DirectDataShareText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding DirectDataShareDetailText}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Historial de GameHours" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Los totales conocidos pueden incluir histórico recuperado; las sesiones siguen siendo la parte exacta."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,3,0,13"
                                   TextWrapping="Wrap" />

                        <UniformGrid Columns="4" Margin="0,0,0,14">
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,7,0">
                                <StackPanel><TextBlock Text="TIEMPO CONOCIDO" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding LifetimeKnownText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock Text="{Binding LifetimeBreakdownText}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,7,0">
                                <StackPanel><TextBlock Text="JUEGOS" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding LifetimeGameCountText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock Text="con actividad conocida" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="0,2,0,0" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12" Margin="0,0,7,0">
                                <StackPanel><TextBlock Text="SESIONES / LOGROS" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding LifetimeSessionsAchievementsText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock Text="medidas · desbloqueados" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="0,2,0,0" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12">
                                <StackPanel><TextBlock Text="JUEGOS AL 100 %" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding LifetimeCompletedText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock Text="solo catálogos completos" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="0,2,0,0" /></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                            <Border Background="#151A23" CornerRadius="10" Padding="14" Margin="0,0,7,7">
                                <StackPanel><TextBlock Text="JUEGO MÁS JUGADO" Foreground="{StaticResource AccentLightBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding LifetimeMostPlayedTitleText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding LifetimeMostPlayedValueText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#151A23" CornerRadius="10" Padding="14" Margin="7,0,0,7">
                                <StackPanel><TextBlock Text="SESIÓN MÁS LARGA" Foreground="{StaticResource AccentLightBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding LongestSessionTitleText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding LongestSessionValueText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                            </Border>
                            <Border Grid.Row="1" Background="#151A23" CornerRadius="10" Padding="14" Margin="0,7,7,0">
                                <StackPanel><TextBlock Text="RACHAS" Foreground="{StaticResource AccentLightBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding CurrentStreakText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="{Binding LongestStreakText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Background="#151A23" CornerRadius="10" Padding="14" Margin="7,7,0,0">
                                <StackPanel><TextBlock Text="PRIMERA ACTIVIDAD CONOCIDA" Foreground="{StaticResource AccentLightBrush}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding FirstKnownActivityText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="Puede proceder de evidencia histórica recuperada." Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   Foreground="{StaticResource MutedTextBrush}"
                   FontSize="9"
                   Margin="2,10,2,0"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
