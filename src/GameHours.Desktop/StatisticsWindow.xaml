<Window x:Class="GameHours.Desktop.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameHours · Estadísticas"
        Width="930" Height="720"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Estadísticas" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="Tu historial medido y el contexto recuperado por GameHours."
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Cerrar"
                    Background="{StaticResource SurfaceAltBrush}"
                    VerticalAlignment="Center"
                    Click="Close_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousButton"
                                    Content="←"
                                    Width="42"
                                    Height="34"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    Click="Previous_Click" />
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding MonthText}"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Solo tiempo medido por GameHours en estadísticas diarias."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           Margin="0,3,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="TodayButton"
                                        Content="Este mes"
                                        Background="#292F3D"
                                        Margin="0,0,8,0"
                                        Click="Today_Click" />
                                <Button x:Name="NextButton"
                                        Content="→"
                                        Width="42"
                                        Height="34"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        Click="Next_Click" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="5" Margin="0,0,0,16">
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="TIEMPO" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding MonthPlaytimeText}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="DÍAS JUGANDO" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding MonthActiveDaysText}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="JUEGOS" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding MonthGameCountText}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="LOGROS" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding MonthAchievementCountText}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="MEDIA / DÍA" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding MonthAverageText}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#151A23" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="MÁS JUGADO" Foreground="{StaticResource AccentLightBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding MonthMostPlayedTitleText}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding MonthMostPlayedValueText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#151A23" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="DÍA MÁS INTENSO" Foreground="{StaticResource AccentLightBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding MonthBusiestDayTitleText}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" />
                                    <TextBlock Text="{Binding MonthBusiestDayValueText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="14"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Historial de GameHours" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Los totales conocidos pueden incluir histórico recuperado; las sesiones siguen siendo la parte exacta."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap" />

                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="TIEMPO CONOCIDO" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding LifetimeKnownText}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding LifetimeBreakdownText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="JUEGOS" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding LifetimeGameCountText}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="con actividad conocida" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="SESIONES / LOGROS" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding LifetimeSessionsAchievementsText}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="medidas · desbloqueados" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="JUEGOS AL 100 %" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding LifetimeCompletedText}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="solo catálogos completos" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Background="#151A23" CornerRadius="10" Padding="16" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="JUEGO MÁS JUGADO" Foreground="{StaticResource AccentLightBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding LifetimeMostPlayedTitleText}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LifetimeMostPlayedValueText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#151A23" CornerRadius="10" Padding="16" Margin="8,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="SESIÓN MÁS LARGA" Foreground="{StaticResource AccentLightBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding LongestSessionTitleText}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LongestSessionValueText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="#151A23" CornerRadius="10" Padding="16" Margin="0,8,8,0">
                                <StackPanel>
                                    <TextBlock Text="RACHAS" Foreground="{StaticResource AccentLightBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding CurrentStreakText}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" />
                                    <TextBlock Text="{Binding LongestStreakText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Background="#151A23" CornerRadius="10" Padding="16" Margin="8,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="PRIMERA ACTIVIDAD CONOCIDA" Foreground="{StaticResource AccentLightBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding FirstKnownActivityText}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" />
                                    <TextBlock Text="Puede proceder de evidencia histórica recuperada."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Content="Actualizar"
                    Background="{StaticResource SurfaceAltBrush}"
                    Click="Refresh_Click" />
        </Grid>
    </Grid>
</Window>
